# Copiá este archivo a .env y completalo. NUNCA subas el .env (está en .gitignore).

# --- Modo de ejecución del sistema ArgenEquip ---
# mock = datos en memoria, no necesita backend (ideal para probar y para la demo reproducible)
# api  = backend real Spring Boot + MySQL en localhost
ARGENEQUIP_MODE=mock

# Solo en modo api:
ARGENEQUIP_BASE_URL=http://localhost:8080
ARGENEQUIP_USER=socio@example.com
ARGENEQUIP_PASSWORD=cambiar_por_la_password

# --- Modelo (ver model.py) ---
# Proveedor con el que arranca la app (se cambia después desde la barra lateral). El modelo de cada
# proveedor se define acá (MODEL_NAME, OPENROUTER_MODEL, GROQ_MODEL) y no se edita desde la pantalla.
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-3.5-flash

# Gemini: clave desde https://aistudio.google.com/apikey
# Se pueden poner varias separadas por coma (GOOGLE_API_KEY=clave1,clave2): cuando una se queda sin cupo,
# el agente pasa solo a la siguiente. Usá solo claves propias o con permiso de su dueño, y respetá los
# términos del proveedor. (Lo mismo vale para OPENROUTER_API_KEY.)
GOOGLE_API_KEY=tu_api_key_aqui

# OpenRouter (opcional): clave desde https://openrouter.ai/keys
# OPENROUTER_MODEL es el slug del modelo (los gratuitos terminan en ":free"; tiene que soportar tool calling).
OPENROUTER_API_KEY=tu_api_key_aqui
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Groq (opcional): clave desde https://console.groq.com/keys
# GROQ_MODEL es el id del modelo (tiene que soportar tool calling; ver la lista en la consola de Groq).
GROQ_API_KEY=tu_api_key_aqui
GROQ_MODEL=openai/gpt-oss-120b
